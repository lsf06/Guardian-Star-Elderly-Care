__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 音频缓存
audio/_cache.mp3
audio/*.mp3

# 六句真人语音默认入库：每句 40–80 KB，是项目的一部分，clone 下来就能播。
# 如果你不想把自己的声音公开到 GitHub，取消下一行注释即可（设备本地仍可用）。
# audio/*.wav

# 本地配置与密钥
.env
*.local

# 逐帧原始采集数据体积大（几分钟就几 MB），不进仓库
data/guardian*.csv
raw*.bin

# 注意：sweep_result.csv 必须进仓库 —— 它是「打扰预算曲线」背后的真实数字，
# 也是这个项目最值得提交的产出之一。不要忽略它。

# 系统杂项
.DS_Store
Thumbs.db
~$*

# lark-cli 读表时会落临时文件到当前目录，防止误提交
*.ndjson
*.manifest.json
